+def test_native_neurons_do_not_move_unselected_weights_or_momentum():
+    mlp=MLP();optimizer=r.NativeNeuronAdam({'x':mlp},.01)
+    before=copy.deepcopy(mlp.state_dict())
+    for p in mlp.parameters():p.grad=torch.ones_like(p)
+    optimizer.step({'x':torch.tensor([1])})
+    after=copy.deepcopy(mlp.state_dict())
+    for field in ('gate_proj','up_proj'):
+        assert torch.equal(before[field+'.weight'][[0,2,3,4,5]],after[field+'.weight'][[0,2,3,4,5]])
+        assert not torch.equal(before[field+'.weight'][1],after[field+'.weight'][1])
+    assert torch.equal(before['down_proj.weight'][:,[0,2,3,4,5]],after['down_proj.weight'][:,[0,2,3,4,5]])
+    optimizer.step({'x':torch.tensor([2])})
+    assert torch.equal(after['down_proj.weight'][:,1],mlp.down_proj.weight[:,1])
+    assert torch.equal(after['gate_proj.weight'][1],mlp.gate_proj.weight[1])
+    saved=optimizer.state_dict()
+    assert saved['slices']['x.down_proj']['indices'].tolist()==[1,2]
+
