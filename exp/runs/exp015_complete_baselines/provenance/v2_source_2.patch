+import copy
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import pytest
+import torch
+import torch.nn.functional as F
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import reproduction_losses as r
+import reproduce_all_baselines as runner
+
+
+class MLP(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.gate_proj=torch.nn.Linear(4,6,bias=False)
+        self.up_proj=torch.nn.Linear(4,6,bias=False)
+        self.down_proj=torch.nn.Linear(6,4,bias=False)
+    def forward(self,x):
+        return self.down_proj(F.silu(self.gate_proj(x))*self.up_proj(x))
+
+
+class Layer(torch.nn.Module):
+    def __init__(self):
+        super().__init__();self.mlp=MLP()
+    def forward(self,x):return x+self.mlp(x)
+
+
+class Toy(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.embed=torch.nn.Embedding(127,4)
+        self.model=torch.nn.Module()
+        self.model.layers=torch.nn.ModuleList([Layer() for _ in range(8)])
+        self.head=torch.nn.Linear(4,127)
+    @property
+    def device(self):return self.head.weight.device
+    def forward(self,input_ids,labels=None,**kwargs):
+        x=self.embed(input_ids)
+        for layer in self.model.layers:x=layer(x)
+        logits=self.head(x)
+        loss=None if labels is None else F.cross_entropy(logits[:,:-1].transpose(1,2),labels[:,1:],ignore_index=-100)
+        return SimpleNamespace(logits=logits,loss=loss)
+
+
+def batch():
+    ids=torch.tensor([[1,2,3,4,5]])
+    return {'input_ids':ids,'labels':torch.tensor([[-100,-100,3,4,5]]),'attention_mask':torch.ones_like(ids)}
+
+
+@pytest.mark.parametrize('method', [x for x in r.METHODS if x not in ('KLUE','RMU')])
+def test_upstream_loss_backward_and_reference_cache(method):
+    torch.manual_seed(5);model=Toy();b=batch()
+    bank=runner.ReferenceBank();bank.capture(model,[b])
+    config=r.profile(method,'matched_lora')
+    trainer=r.bind_trainer(config,model,bank)
+    if method=='PDU':trainer.retain_loss_eps=0.
+    f={'original':b,'alternate':dict(b,labels=torch.tensor([[-100,-100,6,7,8]]))} if method.startswith('DPO') else b
+    value=trainer.compute_loss(model,{'forget':f,'retain':b})
+    assert torch.isfinite(value)
+    value.backward()
+    assert model.head.weight.grad is not None
+    assert torch.isfinite(model.head.weight.grad).all()
+    with torch.no_grad():model.head.weight.add_(.01)
+    # Cache must still return pre-update base output, not the current trainable model.
+    assert not torch.equal(bank(**b).logits,model(**b).logits)
+
+
+@pytest.mark.parametrize('method', ('GA','GradDiff','NPO','SimNPO'))
+def test_basic_loss_and_gradient_against_independent_formula(method):
+    torch.manual_seed(4);model=Toy();b=batch()
+    bank=runner.ReferenceBank();bank.capture(model,[b])
+    with torch.no_grad():model.head.weight.add_(torch.randn_like(model.head.weight)*.01)
+    config=r.profile(method,'matched_lora');t=r.bind_trainer(config,model,bank)
+    actual=t.compute_loss(model,{'forget':b,'retain':b})
+    output=model(**b);ret=output.loss
+    nll=r.answer_nll(output,b['labels']);n=int((b['labels'][:,1:]!=-100).sum())
+    ref=r.answer_nll(bank(**b),b['labels'])
+    if method=='GA':expected=-ret
+    elif method=='GradDiff':expected=-nll/n+ret
+    elif method=='NPO':expected=-2/config['beta']*F.logsigmoid(config['beta']*(nll-ref))+ret
+    else:expected=config['gamma']*(-2/config['beta']*F.logsigmoid(config['beta']*(nll/n-config['delta'])))+ret
+    assert torch.allclose(actual,expected,atol=1e-6)
+    ga=torch.autograd.grad(actual,model.head.weight,retain_graph=True)[0]
+    gb=torch.autograd.grad(expected,model.head.weight)[0]
+    assert torch.allclose(ga,gb,atol=1e-6)
+
