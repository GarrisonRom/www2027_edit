+def test_cpu_adam_matches_torch_adam_on_float32():
+    a=torch.nn.Parameter(torch.tensor([1.,2.]));b=torch.nn.Parameter(a.detach().clone())
+    opt=runner.CPUAdamW([a],.01,.01);reference=torch.optim.AdamW([b],lr=.01,weight_decay=.01)
+    for _ in range(3):
+        a.grad=torch.tensor([2.,-3.]);b.grad=a.grad.clone()
+        opt.step();reference.step()
+        assert torch.equal(a,b)
+
