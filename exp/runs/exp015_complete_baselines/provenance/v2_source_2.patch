+def test_probability_attribution_does_not_mutate_parameters():
+    model=Toy();before=copy.deepcopy(model.state_dict());mlps=r.gated_mlps(model)
+    scores,logp=r.probability_attribution(model,batch(),mlps)
+    assert logp<0 and len(scores)==8
+    assert all(v.shape==(6,) for v in scores.values())
+    assert all(torch.equal(before[k],v) for k,v in model.state_dict().items())
+    assert not any(m._forward_pre_hooks for m in [x.down_proj for x in mlps.values()])
