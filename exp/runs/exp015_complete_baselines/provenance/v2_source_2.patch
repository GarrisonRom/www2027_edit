+def test_rmu_reference_hook_and_embedding_retain():
+    model=Toy();b=batch();bank=runner.ReferenceBank();bank.capture(model,[b],use_hidden=True)
+    t=r.bind_trainer(r.profile('RMU','matched_lora'),model,bank)
+    value=t.compute_loss(model,{'forget':b,'retain':b})
+    assert torch.isfinite(value)
