+def test_dpo_same_question_distinct_mismatched_answer():
+    import random
+    item={'id':'a','question':'question','answer':'answer'}
+    mismatch=runner.alternate(item,[dict(item,answer='other')],'DPOmis',random.Random(42))
+    assert mismatch['question']==item['question'] and mismatch['answer']!='answer'
+    assert runner.alternate(item,[],'DPOrej',random.Random(42))['answer']=="I don't know."
