+def test_yaml_not_constructor_defaults():
+    assert r.profile('NPO','matched_lora')['beta']==.1
+    cfg=r.profile('SimNPO','matched_lora');assert cfg['beta']==4.5 and cfg['gamma']==.125
+    cfg=r.profile('SatImp','matched_lora');assert cfg['gamma']==.1 and cfg['alpha']==1.
+    cfg=r.profile('UNDIAL','matched_lora');assert cfg['beta']==10. and cfg['alpha']==0.
+    assert r.profile('PDU','matched_lora')['primal_dual'] is True
+    assert r.profile('RMU','native')['retain_loss_type']=='EMBED_DIFF'
+    with pytest.raises(ValueError):r.profile('KLUE','matched_lora')
