+def test_native_sparse_checkpoint_restores_full_weights():
+    model=Toy();fresh=copy.deepcopy(model);mlps=r.gated_mlps(model)
+    optimizer=r.NativeNeuronAdam(mlps,.01)
+    selected={key:torch.tensor([1,3]) for key in mlps}
+    for parameter in model.parameters():parameter.grad=torch.ones_like(parameter)
+    optimizer.step(selected)
