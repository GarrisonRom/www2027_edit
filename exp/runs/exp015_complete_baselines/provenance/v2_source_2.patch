+def test_reference_bank_batched_outputs_match_frozen_model():
+    model=Toy();first=batch();second=batch()
+    second['input_ids']=second['input_ids'].clone()+1
+    second['labels']=second['labels'].clone();second['labels'][:,2:]+=1
+    bank=runner.ReferenceBank();bank.capture(model,[first,second],use_hidden=True)
+    combined={key:torch.cat([first[key],second[key]],dim=0) for key in first}
+    actual=bank(**combined);expected=model(**combined)
+    assert torch.allclose(actual.logits,expected.logits,atol=1e-6)
+    assert torch.allclose(actual.loss,expected.loss,atol=1e-6)
+
